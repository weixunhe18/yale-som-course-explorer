# Copy to .env and fill in real values. Never commit .env.
#
# The backend loads BOTH of these, in order, so the key can live either here in
# the project root or one level up in a shared folder:
#   <project>/.env
#   <parent>/.env

# Portkey gateway key, used for all OpenAI model calls. Required.
PORTKEY_API_KEY=pk-your-portkey-key-here

# Database. Leave unset locally — the app then uses data/yale_som.db.
# In production this is the Supabase connection string (Session pooler URI):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Signs the login tokens. Optional locally (a random one is generated per run,
# so restarting the server signs you out). Required in production.
# JWT_SECRET=generate-with-openssl-rand-base64-32

# The deployed frontend's origin, so the browser is allowed to call the API.
# Any localhost port is always allowed, so this is only needed in production.
# FRONTEND_ORIGIN=https://som-course-explorer.onrender.com

# Optional overrides — the defaults are what the lecture uses.
# COURSE_AGENT_MODEL=gpt-5.6-sol
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Frontend only: where the React app looks for the API. Defaults to
# http://127.0.0.1:8000 locally; set to the Render backend URL in production.
# VITE_API_BASE=http://127.0.0.1:8000
